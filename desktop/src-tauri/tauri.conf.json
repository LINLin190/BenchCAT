{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BenchCAT",
  "version": "1.3.1",
  "identifier": "com.benchcat.app",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BenchCAT",
        "width": 1600,
        "height": 1200,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "resources/bridge/": "bridge/"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1QUVEQjRBOEM1QzRFRjIKUldUeVRseU1TdHV1UldvQ09nVWZFMlo5clRlUU5ycmNHQmNXWDRxdUR5ZjJuVVprZ0pER1VnRVoK",
      "endpoints": [
        "https://github.com/LINLin190/BenchCAT/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
